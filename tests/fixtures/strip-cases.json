      "$type": "com.cultureblocs.bead",
      "kind": "read",
      "note": "Pester",
      "refs": [
        {
          "type": "work",
          "role": "subject",
          "descriptor": {
            "label": "The Expansion Project",
            "creator": "Ben Pester"
          },
          "externalIds": [
