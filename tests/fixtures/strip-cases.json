[
  {
    "name": "a bead's geo, provenance and local media never leave",
    "fn": "bead",
    "body": {
      "$type": "com.cultureblocs.bead",
      "createdAt": "2026-08-15T21:04:00Z",
      "kind": "visit",
      "note": "The Rothko room, almost empty.",
      "tags": [
        "gallery",
        "quiet"
      ],
      "geo": {
        "lat": 51.5076,
        "lng": -0.0994,
        "precision": "exact"
      },
      "provenance": {
        "app": "culturebloc",
        "device": "totem-01",
        "mintedAt": "2026-08-15T21:04:00Z",
        "mintId": "9f2c...",
        "timeAnchored": true
      },
      "media": [
        {
          "uri": "/media/abc.jpg",
          "mime": "image/jpeg"
        }
      ]
    },
    "expected": {
      "$type": "com.cultureblocs.bead",
      "createdAt": "2026-08-15T21:04:00Z",
      "kind": "visit",
      "note": "The Rothko room, almost empty.",
      "tags": [
        "gallery",
        "quiet"
      ]
    }
  },
  {
    "name": "a subject publishes as its name alone — the coordinates inside it are dropped",
    "fn": "bead",
    "body": {
      "$type": "com.cultureblocs.bead",
      "createdAt": "2026-08-15T21:04:00Z",
      "kind": "visit",
      "subject": {
        "name": "Tate Modern",
        "did": "did:plc:venue123",
        "geo": {
          "lat": 51.5076,
          "lng": -0.0994,
          "precision": "exact"
        }
      }
    },
    "expected": {
      "$type": "com.cultureblocs.bead",
      "createdAt": "2026-08-15T21:04:00Z",
      "kind": "visit",
      "subject": {
        "name": "Tate Modern"
      }
    }
  },
  {
