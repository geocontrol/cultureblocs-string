          "image": {
            "$type": "blob",
            "ref": {
              "$link": "bafkreiA"
            },
            "mimeType": "image/jpeg",
            "size": 1024
          },
          "alt": "a red canvas",
          "aspectRatio": {
            "width": 4,
            "height": 3
          }
        }
      ]
    }
