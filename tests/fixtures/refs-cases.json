  {
    "name": "combining mark: an anchor ending between 'e' and U+0301 (byte 7) is on a UTF-8 boundary, so it is valid — byte offsets cannot see grapheme clusters",
    "fn": "anchor_problems",
    "args": [
      "com.cultureblocs.strand",
      {
        "narrative": "At Café",
        "refs": [
          {
            "index": {
              "byteStart": 3,
              "byteEnd": 7
            }
          }
        ]
      }
    ],
    "expected": []
  },
  {
    "name": "combining mark: the whole decomposed 'Café' is bytes 3..9, the end of the text",
